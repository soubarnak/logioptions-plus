#!/bin/sh
# Start Options+ for Linux: make sure the agent runs, then open the UI on the
# newest installed Electron 3x with the Chromium sandbox enabled.
#
# Environment (all optional):
#   OPL_PAYLOAD_DIR  Logitech payload (app.asar, data/, depots/, payload.json); default
#                    ${XDG_DATA_HOME:-~/.local/share}/optionsplus-linux/payload, else the
#                    system-wide /usr/lib/optionsplus-linux/logitech (OPL_SYSTEM_PAYLOAD_DIR)
#                    when only that exists. A missing payload is fetched first, after the user
#                    confirms Logitech's EULA; declining exits without starting anything.
#   OPL_ASAR, OPL_DATA_DIR, OPL_DEPOT_DIR  override single payload paths
#   OPL_NO_SANDBOX=1 fallback ONLY if Void's Electron cannot sandbox (adds --no-sandbox)
#   OPL_OZONE_PLATFORM  auto (default), wayland or x11: passes --ozone-platform=<value> to Electron.
#                    Use x11 where the native Wayland window never appears (see the README).
#                    If unset, read from a line OPL_OZONE_PLATFORM=x11 in
#                    ${XDG_CONFIG_HOME:-~/.config}/optionsplus-linux/launcher.conf (never sourced).
#                    The environment wins over the file; other values warn and are ignored.
#   OPL_BIN_DIR, OPL_LIB_DIR, OPL_AGENT_CMD, OPL_FETCH_CMD  locations of Electron, our code, agent and fetcher commands
LIB=${OPL_LIB_DIR:-/usr/lib/optionsplus-linux}
BINDIR=${OPL_BIN_DIR:-/usr/bin}
AGENT=${OPL_AGENT_CMD:-optionsplus-agent}
case $AGENT in */*) ;; *) [ -x "$(dirname "$0")/$AGENT" ] && AGENT=$(dirname "$0")/$AGENT ;; esac
FETCH=${OPL_FETCH_CMD:-optionsplus-fetch-payload}
case $FETCH in */*) ;; *) [ -x "$(dirname "$0")/$FETCH" ] && FETCH=$(dirname "$0")/$FETCH ;; esac

ELECTRON=$(ls -1 "$BINDIR"/electron3[0-9] 2>/dev/null | sort -V | tail -n 1)
if [ -z "$ELECTRON" ]; then
    echo "optionsplus-linux: no Electron 3x found in $BINDIR (install the electron35 package)" >&2
    exit 1
fi

# Restart after an in-app update: the old agent (pid in OPL_RESTART_WAIT_PID) is leaving; wait
# for it so the socket is free and the new agent, not the old one, answers. Gives up after
# OPL_RESTART_WAIT_SECONDS (default 10).
case ${OPL_RESTART_WAIT_PID:-} in
    ''|*[!0-9]*) ;;
    *)
        i=0
        limit=$(( ${OPL_RESTART_WAIT_SECONDS:-10} * 10 ))
        while [ $i -lt $limit ] && kill -0 "$OPL_RESTART_WAIT_PID" 2>/dev/null \
                && ! grep -q '^State:[[:space:]]*Z' "/proc/$OPL_RESTART_WAIT_PID/status" 2>/dev/null; do
            sleep 0.1
            i=$((i + 1))
        done
        ;;
esac
unset OPL_RESTART_WAIT_PID OPL_RESTART_WAIT_SECONDS

USER_PAYLOAD=${XDG_DATA_HOME:-$HOME/.local/share}/optionsplus-linux/payload
SYSTEM_PAYLOAD=${OPL_SYSTEM_PAYLOAD_DIR:-/usr/lib/optionsplus-linux/logitech}
installed() { [ -f "$1/payload.json" ] && [ -f "$1/app.asar" ]; }
pick_payload() {
    if [ -n "${OPL_PAYLOAD_DIR:-}" ]; then PAYLOAD=$OPL_PAYLOAD_DIR
    elif installed "$USER_PAYLOAD"; then PAYLOAD=$USER_PAYLOAD
    elif installed "$SYSTEM_PAYLOAD"; then PAYLOAD=$SYSTEM_PAYLOAD
    else PAYLOAD=$USER_PAYLOAD; fi
}
pick_payload
# No payload yet: fetch it (EULA confirmation inside). Declining stops everything here.
if [ -z "${OPL_ASAR:-}" ] && ! installed "$PAYLOAD"; then
    "$FETCH" || exit $?
    pick_payload
fi
export OPL_ASAR=${OPL_ASAR:-$PAYLOAD/app.asar}
export OPL_DATA_DIR=${OPL_DATA_DIR:-$PAYLOAD/depots/logioptionsplus/data}
export OPL_DEPOT_DIR=${OPL_DEPOT_DIR:-$PAYLOAD/depots}

# The agent writes its own agent.log; this only catches what it prints before logging starts.
if ! "$AGENT" --is-running; then
    LOGDIR=${XDG_STATE_HOME:-$HOME/.local/state}/optionsplus-linux
    mkdir -p "$LOGDIR"
    setsid "$AGENT" >>"$LOGDIR/agent.stderr.log" 2>&1 </dev/null &
    i=0
    while [ $i -lt 100 ] && ! "$AGENT" --is-running; do
        sleep 0.1
        i=$((i + 1))
    done
fi

# Ozone platform override. The config file is parsed, not sourced.
OZONE=${OPL_OZONE_PLATFORM:-}
if [ -z "$OZONE" ]; then
    CONF=${XDG_CONFIG_HOME:-$HOME/.config}/optionsplus-linux/launcher.conf
    if [ -f "$CONF" ]; then
        OZONE=$(grep '^[[:space:]]*OPL_OZONE_PLATFORM=' "$CONF" | tail -n 1 \
            | sed -e 's/^[^=]*=//' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//' -e "s/^[\"']\(.*\)[\"']\$/\1/")
    fi
fi
case $OZONE in
    wayland|x11) set -- "--ozone-platform=$OZONE" "$LIB/bootstrap" "$@" ;;
    ''|auto) set -- "$LIB/bootstrap" "$@" ;;
    *)
        echo "optionsplus-linux: ignoring OPL_OZONE_PLATFORM='$OZONE' (want auto, wayland or x11)" >&2
        set -- "$LIB/bootstrap" "$@"
        ;;
esac

if [ "${OPL_NO_SANDBOX:-}" = 1 ]; then
    exec "$ELECTRON" --no-sandbox "$@"
fi
exec "$ELECTRON" "$@"
